---
import AppleIcon from "./icons/Apple.astro";
import SearchIcon from "./icons/Search.astro";
import MarketIcon from "./icons/Market.astro";
import NavLinks from "./NavLinks.astro";
import SubNav from "./SubNav.astro";
import { MAIN_NAV_ITEMS } from "../constants/navigation";
---

<section class="header">
  <nav class="nav main-nav">
    <AppleIcon class="logo" />
    <NavLinks items={MAIN_NAV_ITEMS} />
    <SearchIcon class="icon-right" />
    <MarketIcon class="icon-right" />
  </nav>

  <SubNav />
</section>

<script>
  import { initHeaderAnimation } from "../scripts/headerAnimation";

  initHeaderAnimation();
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 1000;
  }

  .nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    padding: 0.5rem 2rem;
  }

  .logo {
    width: 25px;
    height: 30px;
    cursor: pointer;
    fill: #bcbcbc;

    &:hover {
      fill: #fff;
    }
  }

  .icon-right {
    width: 20px;
    height: 50px;
    cursor: pointer;
    fill: #bcbcbc;

    &:hover {
      fill: #fff;
    }
  }
</style>
