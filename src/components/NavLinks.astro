---
interface Props {
  items: readonly string[];
  className?: string;
}

const { items, className = "nav-links" } = Astro.props;
---

<ul class={className}>
  {
    items.map((item) => (
      <li>
        <a href="#">{item}</a>
      </li>
    ))
  }
</ul>

<style>
  .nav-links {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    padding-inline-start: 0;
  }

  .nav-links li a {
    color: #bcbcbc;
    text-decoration: none;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      "Open Sans",
      "Helvetica Neue",
      sans-serif;
  }

  .nav-links li a:hover {
    color: #fff;
  }
</style>
