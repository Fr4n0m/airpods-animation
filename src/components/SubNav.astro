---
import NavLinks from "./NavLinks.astro";
import { SUB_NAV_ITEMS } from "../constants/navigation";
---

<div class="subnav">
  <div class="subnav-wrapper">
    <div class="subnav-container">
      <h2 class="subnav-title">AirPods Pro 2</h2>

      <nav class="nav-subnav">
        <NavLinks items={SUB_NAV_ITEMS} />
        <button class="buy-button">Comprar</button>
      </nav>
    </div>
  </div>
</div>

<style>
  .subnav {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .subnav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14rem;
    border-bottom: 1px solid #424245;
  }

  .subnav-title {
    color: rgb(234, 234, 234);
  }

  .nav-subnav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
  }

  .buy-button {
    color: #fff;
    background-color: #017bf5;
    height: 25px;
    padding-inline: 15px;
    border-radius: 9999px;
    border: none;
    font-size: 12px;

    &:hover {
      background-color: #006fdf;
      cursor: pointer;
    }
  }
</style>
