---
import Hero from "../components/Hero.astro";
import Header from "../components/Header.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>AirPods Pro 2 - Apple (ES)</title>
  </head>

  <body>
    <Header />
    <Hero />
    <footer class="site-disclaimer">
      <p class="disclaimer-copy">
        built by
        <a
          class="disclaimer-link disclaimer-author"
          href="https://codebyfran.es"
          target="_blank"
          rel="noopener noreferrer"
        >
          Fr4n0m
        </a>
      </p>
      <span class="disclaimer-dot" aria-hidden="true"></span>
      <a
        class="disclaimer-link disclaimer-github"
        href="https://github.com/Fr4n0m/airpods-animation"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Repositorio en GitHub"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.9.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.75 1.18 1.75 1.18 1.02 1.75 2.68 1.24 3.34.95.1-.74.4-1.24.72-1.53-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.18a10.98 10.98 0 0 1 5.78 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.24 2.75.12 3.04.73.81 1.17 1.84 1.17 3.1 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.08.78 2.18 0 1.58-.01 2.85-.01 3.24 0 .31.2.68.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
          ></path>
        </svg>
      </a>
    </footer>
  </body>

  <script>
    import { initScrollInertia } from "../scripts/scrollInertia";

    initScrollInertia();
  </script>

  <style>
    body {
      font-family:
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Oxygen,
        Ubuntu,
        Cantarell,
        "Open Sans",
        "Helvetica Neue",
        sans-serif;
      background: #000;
      color: #fff;
      height: 5000px;
      font-size: 12px;
      overscroll-behavior: none;
      position: relative;
    }

    .site-disclaimer {
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 16px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: rgba(28, 28, 30, 0.42);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      box-shadow:
        0 10px 28px rgba(0, 0, 0, 0.45),
        inset 0 1px 0 rgba(255, 255, 255, 0.08);
      color: #c7c7cc;
      font-size: 11px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      z-index: 1200;
      transition:
        background-color 0.2s ease,
        border-color 0.2s ease;
    }

    .site-disclaimer:hover {
      background: rgba(18, 18, 18, 0.68);
      border-color: rgba(255, 255, 255, 0.2);
    }

    .disclaimer-copy {
      margin: 0;
      color: #8e8e93;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .disclaimer-dot {
      width: 4px;
      height: 4px;
      border-radius: 999px;
      background: #6e6e73;
    }

    .disclaimer-link {
      color: rgba(245, 245, 247, 0.92);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .disclaimer-author {
      text-transform: none;
    }

    .disclaimer-github {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 18px;
      height: 18px;
    }

    .disclaimer-github svg {
      width: 16px;
      height: 16px;
      fill: currentColor;
    }

    .disclaimer-link:hover {
      color: #8e8e93;
    }

    @media (max-width: 640px) {
      .site-disclaimer {
        gap: 8px;
        padding: 8px 12px;
        font-size: 10px;
      }
    }
  </style>
</html>
